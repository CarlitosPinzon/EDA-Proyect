<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Librería transversal: concentra la lógica de infraestructura que todos los servicios necesitan
    (pipeline de consumo, relevo del outbox, idempotencia, DLQ, telemetría, JWT y health checks)
    para no repetirla en cada servicio (principio DRY, ver matriz de principios).
  -->
  <PropertyGroup>
    <RootNamespace>TaquillaEDA.BuildingBlocks</RootNamespace>
    <AssemblyName>TaquillaEDA.BuildingBlocks</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" />
    <PackageReference Include="Elastic.Clients.Elasticsearch" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Contracts\Contracts.csproj" />
  </ItemGroup>
</Project>
