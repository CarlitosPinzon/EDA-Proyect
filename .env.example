# Copie este archivo como .env para cambiar la configuración de la demo (opcional).
# docker compose lee .env automáticamente. Todos los valores tienen un valor por defecto.

# Clave para firmar los JWT (mínimo 32 caracteres). Cámbiela fuera del taller.
JWT_CLAVE=clave-de-desarrollo-taquilla-eda-solo-para-el-taller-2026

# Minutos que se retienen los cupos sin pago antes de expirar la reserva (el diseño usa 10).
MINUTOS_EXPIRACION=10

# Sala de espera: reservas admitidas por evento en cada ventana de N segundos.
SALA_ESPERA_PERMISOS=20
SALA_ESPERA_SEGUNDOS=10

# Pasarela simulada: latencia media (ms), probabilidad de falla 503 y de rechazo 402 (0 a 1),
# y monto máximo que aprueba (por encima responde "Fondos insuficientes").
LATENCIA_MS=300
TASA_FALLO=0
TASA_RECHAZO=0
MONTO_MAXIMO=2000000

# Cargar eventos de ejemplo al arrancar si el catálogo está vacío.
CARGAR_SEMILLA=true

# Modo distribuido (dos PCs): IP del PC principal en la red local. Kafka se la entrega a los
# clientes que se conectan desde fuera de Docker. Con "localhost" todo funciona en un solo PC.
IP_ANFITRION=localhost

# Solo en el segundo PC: nombre con el que se identifican sus réplicas (inventario-pc2, pagos-pc2)
# en Kafbat UI, en Aspire Dashboard y en los logs. Ver GUIA-DEMO-2PCS.md.
NOMBRE_NODO=pc2
