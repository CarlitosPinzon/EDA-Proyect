{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taquilla-eda.local/schemas/pago-rechazado.v1.schema.json",
  "title": "PagoRechazado",
  "description": "La pasarela rechazó el cobro o no estuvo disponible tras los reintentos. Tópico pagos.v1, clave de partición reservaId. CloudEvents type: co.taquilla.pagos.pago-rechazado.v1",
  "type": "object",
  "required": [
    "reservaId",
    "monto",
    "motivo"
  ],
  "properties": {
    "reservaId": {
      "type": "string",
      "format": "uuid"
    },
    "monto": {
      "type": "number",
      "minimum": 0
    },
    "motivo": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
