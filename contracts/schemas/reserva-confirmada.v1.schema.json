{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taquilla-eda.local/schemas/reserva-confirmada.v1.schema.json",
  "title": "ReservaConfirmada",
  "description": "Reservas confirmó la reserva tras el pago aprobado. Tópico reservas.v1, clave de partición localidadId. CloudEvents type: co.taquilla.reservas.reserva-confirmada.v1",
  "type": "object",
  "required": [
    "reservaId",
    "eventoId",
    "localidadId",
    "cantidad",
    "total",
    "correoCliente",
    "nombreCliente"
  ],
  "properties": {
    "reservaId": {
      "type": "string",
      "format": "uuid"
    },
    "eventoId": {
      "type": "string",
      "format": "uuid"
    },
    "localidadId": {
      "type": "string",
      "format": "uuid"
    },
    "cantidad": {
      "type": "integer",
      "minimum": 1
    },
    "total": {
      "type": "number",
      "minimum": 0
    },
    "correoCliente": {
      "type": "string",
      "format": "email"
    },
    "nombreCliente": {
      "type": "string",
      "minLength": 1
    },
    "nombreEvento": {
      "type": [
        "string",
        "null"
      ]
    },
    "nombreLocalidad": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
