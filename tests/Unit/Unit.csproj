<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pruebas unitarias del dominio (Localidad, Reserva, Pago, Catálogo) y de la aplicación con fakes. -->
  <PropertyGroup>
    <AssemblyName>TaquillaEDA.Tests.Unit</AssemblyName>
    <RootNamespace>TaquillaEDA.Tests.Unit</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Inventario\Inventario.csproj" />
    <ProjectReference Include="..\..\src\Reservas\Reservas.csproj" />
    <ProjectReference Include="..\..\src\Catalogo\Catalogo.csproj" />
    <ProjectReference Include="..\..\src\Pagos\Pagos.csproj" />
    <ProjectReference Include="..\..\src\Notificaciones\Notificaciones.csproj" />
  </ItemGroup>
</Project>
